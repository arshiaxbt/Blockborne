{
  "name": "fastevm-fighters",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "HOME=/tmp NEXT_TEST_WASM=1 NEXT_TEST_WASM_DIR=$PWD/node_modules/@next/swc-wasm-nodejs next dev",
    "build": "HOME=/tmp NEXT_TEST_WASM=1 NEXT_TEST_WASM_DIR=$PWD/node_modules/@next/swc-wasm-nodejs next build",
    "start": "next start",
    "lint": "eslint",
    "hardhat:compile": "HOME=/tmp TS_NODE_PROJECT=tsconfig.hardhat.json hardhat compile",
    "deploy:monad": "HOME=/tmp TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network monadTestnet",
    "deploy:megaeth": "HOME=/tmp TS_NODE_PROJECT=tsconfig.hardhat.json hardhat run scripts/deploy.ts --network megaethTestnet"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.23.1",
    "@tanstack/react-query": "^5.100.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^15.5.15",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "viem": "^2.47.12",
    "wagmi": "^3.6.9"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^15.5.15",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@nomicfoundation/solidity-analyzer-linux-x64-gnu": "^0.1.2",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "hardhat": "^2.28.6",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.59.1"
  }
}
